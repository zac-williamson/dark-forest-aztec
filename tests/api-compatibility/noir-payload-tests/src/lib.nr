#[test]
unconstrained fn raw_late_event_patch_retains_every_tail_slot_and_timestamp() {
    for count in 1..21 {
        let mut typed = PlanetEvents::zero();
        typed.count = count;
        typed.last_updated = 18446744073709551615;
        for i in 0..20 { typed.events[i].id = -(i as Field) - 50; }
        let mut raw = typed.serialize();
        let event_id: Field = -1;
        typed.events[typed.count - 1].id = event_id;
        assert((raw[20] as u32) > 0);
        assert((raw[20] as u32) <= 20);
        raw[(raw[20] as u32) - 1] = event_id;
        assert(raw == typed.serialize(), "Late event patch changed another field");
    }
}
